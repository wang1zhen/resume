\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resume}[2026/02/07 Shared resume style]

\RequirePackage[margin=1.35cm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{hyperref}
\RequirePackage{graphicx}
\RequirePackage{fontawesome5}
\RequirePackage{multicol}
\RequirePackage{fontspec}
% xeCJK is required for Japanese line breaking. fontspec alone gives XeTeX no
% break opportunities inside a CJK run, so a long Japanese sentence overflows
% its box and is silently clipped instead of wrapping.
\RequirePackage{xeCJK}

% Serif body. The family is "Noto Serif CJK JP" — note that "Noto Sans Serif CJK"
% is not a real family and silently falls back to Latin-only Noto Sans, which
% breaks every CJK glyph. Both faces ship in Debian's fonts-noto-cjk, which is
% what CI already installs, so no workflow change is needed.
\setmainfont{Noto Serif CJK JP}
\setsansfont{Noto Sans CJK JP}
\setCJKmainfont{Noto Serif CJK JP}
\setCJKsansfont{Noto Sans CJK JP}

% Cool, high-contrast neutrals with a single deep-navy accent. The previous
% palette was warm and low-saturation (beige card, cream badge, dusty blue-grey
% bars), which reads soft rather than precise. Everything here is cool-biased and
% the contrast is raised: near-black text, true grey secondary, navy section bars.
\definecolor{DarkInk}{HTML}{14181D}
\definecolor{SteelGrey}{HTML}{5A636E}
\definecolor{AccentDeep}{HTML}{17395C}
\definecolor{AccentSoft}{HTML}{E9EDF2}
\definecolor{CardBg}{HTML}{F7F9FB}

\AtBeginDocument{\color{DarkInk}}

\newcommand{\sectionrule}{\textcolor{SteelGrey!45}{\rule{\linewidth}{0.5pt}}}
\newcommand{\cvsection}[1]{%
  \vspace{3pt}%
  \noindent\colorbox{AccentDeep}{%
    \parbox{\dimexpr\linewidth-2\fboxsep\relax}{\textcolor{white}{\large\bfseries #1}}%
  }\par\vspace{1pt}%
}
\newcommand{\contactitem}[2]{\textcolor{SteelGrey}{#1}\,#2}
\newcommand{\rolebadge}[1]{%
  \colorbox{AccentSoft}{\textcolor{AccentDeep}{\small\bfseries\strut #1}}%
}
\newcommand{\furiname}[4]{%
  \begin{tabular}[t]{@{}cc@{}}%
    {\large #1} & {\large #2}\\[-1pt]%
    {\Huge\bfseries #3} & {\Huge\bfseries #4}%
  \end{tabular}%
}
\newenvironment{cvitems}{\begin{itemize}[leftmargin=*,itemsep=1.5pt,topsep=1pt]}{\end{itemize}}
\newcommand{\eduentry}[5]{%
  \vspace{4pt}%
  \noindent\fcolorbox{SteelGrey!45}{CardBg}{%
    \parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{%
      \begin{tabular*}{\linewidth}{@{\extracolsep{\fill}} l r}
        \textbf{#1} & {\small\textcolor{AccentDeep}{\bfseries #4}}\\
        {\small #2} & {\small\textcolor{SteelGrey}{#3}}\\
      \end{tabular*}%
      \if\relax\detokenize{#5}\relax
        \vspace{2pt}%
      \else
        \vspace{-3pt}%
        \begin{cvitems}
          #5
        \end{cvitems}
      \fi
    }%
  }%
}

\setlength{\parindent}{0pt}
\setlength{\parskip}{1.5pt}
\setlist[itemize]{leftmargin=*,itemsep=1.5pt,topsep=1pt,label=\textcolor{AccentDeep}{\small$\circ$}}

\hypersetup{
  colorlinks=true,
  linkcolor=AccentDeep,
  urlcolor=AccentDeep
}
